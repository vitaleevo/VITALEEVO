# Cópia para .env — nunca commitar segredos reais.
DJANGO_ENV=development
SECRET_KEY=dev-only-secret-key-change-me-!1234567890abcdef
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Dados:
# - Testes / Dev Local: Deixe DATABASE_URL vazio para usar SQLite local (db.sqlite3) automaticamente.
# - Produção (Railway, Neon, RDS, etc.): Forneça a URL de conexão PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# REDIS_URL=redis://default:pass@host:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vitaleevo.ao,https://www.vitaleevo.ao
CSRF_TRUSTED_ORIGINS=https://api.vitaleevo.ao

# E-mail (opcional em dev; obrigatório em produção)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@vitaleevo.ao
PASSWORD_RESET_TIMEOUT=900

# Bootstrap manual: use apenas com `python manage.py ensure_admin`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

SITE_URL=https://vitaleevo.ao
